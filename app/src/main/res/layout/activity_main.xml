<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Action Bar (New, Open, Save, Save As, Undo, Redo, Theme, Preview) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#1E1E1E">

        <Button
            android:id="@+id/btnNew"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="@string/action_new"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnOpen"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="@string/action_open"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="@string/action_save"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSaveAs"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="@string/action_save_as"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.8"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="@string/action_undo"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRedo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.8"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="@string/action_redo"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTheme"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="@string/action_theme"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPreview"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="@string/action_preview"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- File and Status Bar -->
    <LinearLayout
        android:id="@+id/fileBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:background="#1E1E1E">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="untitled.txt" />

        <TextView
            android:id="@+id/tvEditorInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:text="Ln 1, Col 1 | Plain Text" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:background="#1E1E1E"
        android:textColor="#888888"
        android:textSize="11sp"
        android:text="@string/welcome_placeholder" />

    <!-- Ace Editor & Markdown Preview WebView Container -->
    <WebView
        android:id="@+id/webViewEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
